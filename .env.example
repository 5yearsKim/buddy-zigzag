# Relative paths are resolved against this file's directory.
BUDDY_MLIR_BUILD_DIR=third_party/buddy-mlir/build
LLVM_MLIR_BUILD_DIR=third_party/buddy-mlir/llvm/build
# Reference interpreter used for Buddy's build; its Python ABI must match uv's.
BUDDY_ZIGZAG_PYTHON=third_party/buddy-mlir/.venv/bin/python
ZIGZAG_SOURCE_DIR=third_party/zigzag
PYTHONPATH=third_party/buddy-mlir/build/python_packages:third_party/zigzag
ARTIFACTS_DIR=artifacts
